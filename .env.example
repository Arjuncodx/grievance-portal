# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=district_collector_dashboard

# ==================== AUTH ====================
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ==================== SMTP (for OTP / password reset emails) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="District Collectorate - Chennai" <no-reply@example.com>

# ==================== AI CLASSIFICATION ====================
# Used server-side only to classify "Others" complaints into a department.
# If omitted, the app falls back to a keyword-based classifier automatically.
OPENAI_API_KEY=sk-your-openai-api-key

# ==================== MAP ====================
# The map uses free OpenStreetMap tiles via Leaflet.js — no API key required.
# If you later obtain a Google Maps API key, set it here and swap the map
# component (src/components/MapPicker.tsx) to the Google Maps JS API variant.
# GOOGLE_MAPS_API_KEY=

# ==================== APP ====================
# Set to "true" to show OTPs in a dev-mode toast in the UI (useful when SMTP/SMS
# is not configured). Never enable this in production.
NEXT_PUBLIC_DEV_SHOW_OTP=true
NODE_ENV=development
