# =============================================================================
# Copy to .env and fill in. NEVER commit a real .env — every value below is a
# placeholder, not a working credential.
# =============================================================================

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=district_collector_dashboard

# ==================== AUTH ====================
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Dedicated key for Aadhaar encryption at rest. If unset, the app derives one
# from JWT_SECRET — acceptable in development, not in production, because
# rotating JWT_SECRET would then make stored Aadhaar numbers undecryptable.
AADHAAR_ENCRYPTION_KEY=

# =============================================================================
# SMTP - optional.
# Used for password-reset codes and mobile-number verification emails. There is
# no email verification at registration, so the app runs without this; those two
# flows simply cannot send mail until it is set.
# =============================================================================
#
# FREE-TIER OPTIONS (checked September 2026 — providers change these, so
# confirm current limits before relying on them):
#
#  Brevo (formerly Sendinblue)  https://www.brevo.com
#    ~300 emails/day on the free plan. Requires verifying your sender address,
#    and domain authentication (SPF/DKIM via DNS records) before it will send
#    from your own domain. SMTP host: smtp-relay.brevo.com, port 587.
#
#  Resend                       https://resend.com
#    ~3,000 emails/month / 100 per day free. Until you verify a domain you may
#    only send to your own registered address, which is fine for development
#    but will silently block real citizen signups. SMTP host: smtp.resend.com,
#    port 587 (user "resend", password = your API key).
#
#  Mailgun                      https://www.mailgun.com
#    Free trial credits, then paid. Sandbox domains only deliver to
#    "authorised recipients" you add manually.
#
#  Gmail / Google Workspace
#    ~500 recipients/day (2,000 for Workspace). Requires 2-Step Verification and
#    an App Password — your normal Google password will NOT work. Google may
#    rate-limit or block bulk sending from a personal account, so this is
#    suitable for development only.
#
# SENDER / DOMAIN VERIFICATION: every provider above requires you to prove you
# own the From address before it will deliver to third parties. Expect to add
# SPF, DKIM and (often) DMARC DNS records. Without them, messages are commonly
# accepted by the provider and then dropped or spam-foldered by the recipient —
# which this app cannot detect, since it can only report whether the SMTP server
# accepted the message.
#
# DELIVERABILITY: none of these guarantee inbox placement. Government-domain
# senders are often filtered aggressively. Test with real addresses on several
# providers before launch.
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_api_key
SMTP_FROM="District Collectorate - Chennai" <no-reply@your-verified-domain.example>

# ==================== AI CLASSIFICATION (optional) ====================
# Used server-side only. If omitted, a keyword classifier is used instead.
OPENAI_API_KEY=

# =============================================================================
# MAPS
# =============================================================================
#
# WITHOUT a key, the complaint location picker falls back to Leaflet +
# OpenStreetMap: the citizen can still place, drag and submit a pin, and the
# ward is still resolved from this app's own boundary polygons. Only address
# SEARCH and automatic address fill are unavailable, and the form says so.
#
# WITH a key, the picker uses the Google Maps JavaScript API.
#
# REQUIRED GOOGLE CLOUD APIS (enable all three):
#   - Maps JavaScript API   (renders the map)
#   - Places API            (address search / autocomplete)
#   - Geocoding API         (reverse geocoding a dropped pin)
#
# BILLING: Google Maps Platform requires an enabled billing account even to use
# the free allowance. Requests are rejected until billing is active.
#
# COST: Google grants Maps Platform usage a monthly free allowance (historically
# a $200/month credit; Google restructured this into per-API monthly free call
# volumes in 2025). The details change, so check current pricing at
# https://mapsplatform.google.com/pricing/ before deployment. Usage beyond the
# free allowance is billed. Google Maps is NOT unlimited and NOT guaranteed
# free.
#
# CAPPING SPEND: a budget alert only emails you — it does NOT stop charges. To
# actually limit spend, set per-API quota limits in
#   Google Cloud Console -> APIs & Services -> <API> -> Quotas
# (e.g. a daily cap on Maps JavaScript API loads, Places requests and Geocoding
# requests). Requests past the quota fail, and this app degrades to the manual
# path rather than continuing to bill.
#
# KEY RESTRICTIONS: the key below is exposed to the browser by design
# (NEXT_PUBLIC_). Restrict it in the Cloud Console to:
#   - Application restriction: HTTP referrers, listing only your own origins
#   - API restriction: only the three APIs listed above
# An unrestricted browser key can be copied off your page and billed to you.
#
# If you ever add SERVER-side Google calls, use a SEPARATE, IP-restricted key
# in a non-public variable. Never reuse the browser key server-side, and never
# put a server key in a NEXT_PUBLIC_ variable.
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ==================== APP ====================
# Shows OTPs in the UI/API responses for local testing. This is IGNORED unless
# NODE_ENV is also non-production, so leaving it "true" by mistake in a
# production deployment cannot leak a code.
NEXT_PUBLIC_DEV_SHOW_OTP=false
NODE_ENV=development
